diff --git a/hw/ip/flash_ctrl/rtl/flash_ctrl.sv b/hw/ip/flash_ctrl/rtl/flash_ctrl.sv
index 17921cb03c..80e83ceef6 100644
--- a/hw/ip/flash_ctrl/rtl/flash_ctrl.sv
